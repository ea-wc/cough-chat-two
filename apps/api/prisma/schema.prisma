generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum DoctorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ConsultationState {
  SCHEDULED
  JOINED
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  BOOKING
  UPCOMING
  CANCELLATION
  SCHEDULE_CHANGE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  appointments   Appointment[]  @relation("PatientAppointments")
  doctorAppts    Appointment[]  @relation("DoctorAppointments")
  notifications  Notification[]
  auditLogs      AuditLog[]
  prescriptions  Prescription[] @relation("PatientPrescriptions")
  writtenPrescriptions Prescription[] @relation("DoctorPrescriptions")
}

model PatientProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  firstName      String
  lastName       String
  birthday       DateTime?
  weightKg       Float?
  heightCm       Float?
  phone          String?
  address        String?
  medicalHistory String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorProfile {
  id               String               @id @default(cuid())
  userId           String               @unique
  firstName        String
  lastName         String
  bio              String?
  specialization   String
  licenseNumber    String?
  approvalStatus   DoctorApprovalStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilities Availability[]
}

model Availability {
  id        String     @id @default(cuid())
  doctorId  String
  startAt   DateTime
  endAt     DateTime
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())

  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([doctorId, startAt])
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  doctorId       String
  availabilityId String?
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(SCHEDULED)
  symptoms       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient      User          @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor       User          @relation("DoctorAppointments", fields: [doctorId], references: [id])
  availability Availability? @relation(fields: [availabilityId], references: [id])
  consultation Consultation?
}

model Consultation {
  id            String            @id @default(cuid())
  appointmentId String            @unique
  state         ConsultationState @default(SCHEDULED)
  notes         String?
  summary       String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
}

model Prescription {
  id             String   @id @default(cuid())
  consultationId String
  patientId      String
  doctorId       String
  medication     String
  dosage         String
  instructions   String?
  issuedAt       DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patient      User         @relation("PatientPrescriptions", fields: [patientId], references: [id])
  doctor       User         @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id             String   @id @default(cuid())
  adminId        String
  action         String
  affectedRecord String
  reason         String?
  timestamp      DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])
}
