{
  "name": "cough-chat-two",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telehealth MVP - a functional prototype with a public product landing page plus Patient, Doctor, and Admin interfaces.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm --filter web lint && pnpm --filter api lint",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "e2e": "pnpm --filter e2e test",
    "e2e:install": "pnpm --filter e2e exec playwright install chromium",
    "e2e:report": "pnpm --filter e2e report"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.1",
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
