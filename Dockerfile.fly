# Single self-contained image: PostgreSQL + NestJS API + Next.js web,
# supervised by scripts/run.sh. Built from the repository root:
#   fly deploy --dockerfile Dockerfile.fly

FROM node:20-slim

# PostgreSQL (in-container DB), OpenSSL (Prisma), curl + a current CA bundle.
# The node:20-slim image ships a Debian CA store that can lag behind npm's CDN,
# causing "invalid peer certificate: UnknownIssuer" during pnpm install. We fetch
# the current Mozilla bundle and add it as an extra trust anchor for Node.
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends ca-certificates curl openssl postgresql postgresql-contrib \
  && curl -fsSL https://curl.se/ca/cacert.pem -o /etc/ssl/certs/mozilla-cacert.pem \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/mozilla-cacert.pem

RUN npm install -g pnpm@12.6.0

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/api/prisma apps/api/prisma
COPY apps/web/package.json apps/web/package.json
COPY apps/e2e/package.json apps/e2e/package.json

# Install workspace dependencies.
RUN pnpm install --frozen-lockfile

# Build the API and the web app.
COPY apps/api apps/api
COPY apps/web apps/web
RUN pnpm --filter api exec prisma generate
RUN pnpm --filter api build

# The browser reaches the API through the same origin (Next.js rewrite), so the
# API base URL is relative in this image.
ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm --filter web build

COPY scripts/run.sh /app/run.sh
RUN chmod +x /app/run.sh

EXPOSE 8080
ENTRYPOINT ["/app/run.sh"]
